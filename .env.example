# ---- Django ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=vendorhub.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://vendorhub.example.com
DJANGO_SSL_REDIRECT=true

# ---- Database (PostgreSQL 16) ----
POSTGRES_DB=mehub
POSTGRES_USER=mehub
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# ---- Hub behaviour ----
# true = SAP / Amazon steps are simulated so every flow can be clicked through (UAT, demos).
HUB_DEMO_SIMULATIONS=false
# true = user-picker sign-in page. Never enable in production.
HUB_DEV_LOGIN=false
# false = no Django admin at /admin/ (recommended on any host shown to clients; use `manage.py shell` on the server instead).
HUB_DJANGO_ADMIN=true
HUB_MEDIA_ROOT=/data/media
HUB_LOG_LEVEL=INFO
HUB_FROM_EMAIL=vendorhub@modern-electronics.example

# ---- JSON API for system integrations (optional) ----
HUB_API_TOKEN=
HUB_API_USER=admin

# ---- Microsoft Entra ID sign-in (leave empty to disable) ----
OIDC_TENANT_ID=
OIDC_RP_CLIENT_ID=
OIDC_RP_CLIENT_SECRET=
# Entra group object id -> hub role (PIC, Planning, Credit, Logistics, Product, Finance, Manager, Admin)
OIDC_GROUP_ROLE_MAP=00000000-0000-0000-0000-000000000001:PIC,00000000-0000-0000-0000-000000000002:Finance

# ---- Claude for reconciliation matching (optional) ----
# off = connect from Settings → Matching instead (key stored encrypted), or rules-only suggestions.
# bedrock = Amazon Bedrock with the server's AWS role (recommended for production); anthropic = needs ANTHROPIC_API_KEY.
HUB_AI_PROVIDER=off
HUB_AI_REGION=ap-south-1
# Key used to encrypt secrets entered in the app (defaults to one derived from DJANGO_SECRET_KEY).
HUB_SECRETS_KEY=

# ---- Amazon Selling Partner API (vendor) — optional ----
# Credentials of ME's private SP-API app (Vendor Central → Integration → API integration). Set here only, never in the app.
# Then Settings → Integrations → Amazon Vendor Central: mode API, vendor codes, ship-from party ID, VAT number.
HUB_SPAPI_CLIENT_ID=
HUB_SPAPI_CLIENT_SECRET=
HUB_SPAPI_REFRESH_TOKEN=
# true = Amazon's static sandbox (sandbox.sellingpartnerapi-eu.amazon.com) for a first test
HUB_SPAPI_SANDBOX=false
# Amazon.sa; change only for another marketplace
HUB_SPAPI_MARKETPLACE_ID=A17E79C6D8DWNP
